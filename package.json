{
  "name": "webarchy",
  "version": "0.1.0",
  "description": "A tiling desktop that runs in a browser tab - keyboard first, inspired by Hyprland and Omarchy.",
  "homepage": "https://webarchy.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webarchy/webarchy.git"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "bun scripts/build.js --dev",
    "build": "bun scripts/build.js",
    "build:prod": "bun scripts/build.js --prod",
    "test": "bun run test:types && bun run test:svelte && bun run test:unit",
    "test:types": "bunx tsc --noEmit -p tsconfig.json",
    "test:svelte": "bunx svelte-check --workspace src --threshold warning",
    "test:unit": "bun test src"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
